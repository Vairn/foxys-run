@echo off
setlocal EnableExtensions
set "ROOT=%~dp0"
set "ROOT=%ROOT:~0,-1%"

rem Launch the built binary in WinUAE.
rem   launch.bat            -> A1200: 68020, AGA, 2 MB chip, Kickstart 3.1
rem   launch.bat a500       -> A500: 68000, OCS, 1 MB chip, Kickstart 1.3
rem   launch.bat file       -> same machine, HD is build-file\
rem   launch.bat a500 file  -> both
rem chipmem_size: 2 is 1 MB, 4 is 2 MB. 512 KB chip does not fit the scroll bitmaps.

set "MACHINE=a1200"
set "HD=%ROOT%\build"
if /I "%~1"=="a500" set "MACHINE=a500"
if /I "%~1"=="file" set "HD=%ROOT%\build-file"
if /I "%~2"=="a500" set "MACHINE=a500"
if /I "%~2"=="file" set "HD=%ROOT%\build-file"
if not "%~1"=="" if /I not "%~1"=="a500" if /I not "%~1"=="file" (
  echo Unknown launch option: %~1
  echo Usage: launch.bat [a500] [file]
  exit /b 1
)
if not "%~2"=="" if /I not "%~2"=="a500" if /I not "%~2"=="file" (
  echo Unknown launch option: %~2
  echo Usage: launch.bat [a500] [file]
  exit /b 1
)

if not exist "%HD%\sunnyland.exe" if not exist "%HD%\sunnyland" (
  echo Missing sunnyland binary. Run build.bat first.
  exit /b 1
)

set "WINUAE="
if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE.exe"
)
if not defined WINUAE (
  echo WinUAE not found. Install Amiga Forever or WinUAE.
  exit /b 1
)

set "ROMDIR=%Public%\Documents\Amiga Files\Shared\rom"
if not exist "%ROMDIR%" set "ROMDIR=%Public%\Documents\Amiga Files\WinUAE\rom"

set "QUICK=A1200,0"
set "CHIPSET=aga"
set "CPU=68020"
set "CHIPMEM=4"
set "LABEL=A1200 + SunnyLand HD"
set "UAE=%ROOT%\sunnyland_a1200.uae"
set "KICK=%ROMDIR%\amiga-os-310-a1200.rom"
if /I "%MACHINE%"=="a500" (
  set "QUICK=A500,0"
  set "CHIPSET=ocs"
  set "CPU=68000"
  set "CHIPMEM=2"
  set "LABEL=A500 + SunnyLand HD"
  set "UAE=%ROOT%\sunnyland_a500.uae"
  set "KICK=%ROMDIR%\amiga-os-130.rom"
)

if not exist "%KICK%" (
  echo Kickstart ROM not found for %MACHINE% under:
  echo   %ROMDIR%
  exit /b 1
)

(
  echo ; Auto-generated by launch.bat — %LABEL%
  echo use_gui=no
  echo quickstart=%QUICK%
  echo kickstart_rom_file=%KICK%
  echo chipset=%CHIPSET%
  echo cpu_type=%CPU%
  echo cpu_model=%CPU%
  echo fpu_model=0
  echo chipmem_size=%CHIPMEM%
  echo bogomem_size=0
  echo fastmem_size=0
  echo floppy0=
  echo floppy1=
  echo filesystem2=rw,DH0:SunnyLand:%HD%,0
  echo uaehf0=dir,rw,DH0:SunnyLand:%HD%,0
  echo boot_rom_uae=auto
  echo input.config=0
  echo joyport0=mouse
  echo joyport1=joy1
) > "%UAE%"

echo Machine: %MACHINE%  (cpu=%CPU%, chipset=%CHIPSET%, chipmem_size=%CHIPMEM%)
echo HD:     %HD%
echo Kick:   %KICK%
echo WinUAE: %WINUAE%
echo.
echo The startup-sequence launches sunnyland.exe.
if /I "%HD%"=="%ROOT%\build-file" echo Log file: %HD%\sunnyland.log
echo.
start "" "%WINUAE%" -f "%UAE%"
endlocal
