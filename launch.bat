@echo off
setlocal EnableExtensions
set "ROOT=%~dp0"
set "ROOT=%ROOT:~0,-1%"

rem Launch the built SunnyLand binary in WinUAE as a stock A1200:
rem 68020, AGA, 2 MB chip, no trapdoor slow RAM, no fast RAM.
rem chipmem_size=4 is 2 MB.

set "HD=%ROOT%\build"
if /I "%~1"=="file" set "HD=%ROOT%\build-file"
if not exist "%HD%\sunnyland.exe" if not exist "%HD%\sunnyland" (
  echo Missing sunnyland binary. Run build.bat first.
  exit /b 1
)

set "WINUAE="
if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE.exe"
)
if not defined WINUAE (
  echo WinUAE not found. Install Amiga Forever or WinUAE.
  exit /b 1
)

rem Kickstart 3.1 for the A1200.
set "KICK=%Public%\Documents\Amiga Files\Shared\rom\amiga-os-310-a1200.rom"
if not exist "%KICK%" set "KICK=%Public%\Documents\Amiga Files\Shared\rom\Kickstart v3.1 rev 40.68 (1993)(Commodore)(A1200).rom"
if not exist "%KICK%" set "KICK=%Public%\Documents\Amiga Files\WinUAE\rom\amiga-os-310-a1200.rom"
if not exist "%KICK%" (
  echo Kickstart 3.1 A1200 ROM not found under Amiga Files\...\rom
  exit /b 1
)

set "UAE=%ROOT%\sunnyland_a1200.uae"
(
  echo ; Auto-generated by launch.bat — A1200 + SunnyLand HD
  echo use_gui=no
  echo quickstart=A1200,0
  echo kickstart_rom_file=%KICK%
  echo chipset=aga
  echo cpu_type=68020
  echo cpu_model=68020
  echo fpu_model=0
  echo chipmem_size=4
  echo bogomem_size=0
  echo fastmem_size=0
  echo floppy0=
  echo floppy1=
  echo filesystem2=rw,DH0:SunnyLand:%HD%,0
  echo uaehf0=dir,rw,DH0:SunnyLand:%HD%,0
  echo boot_rom_uae=auto
  echo input.config=0
  echo joyport0=mouse
  echo joyport1=joy1
) > "%UAE%"

echo Machine: A1200  (68020, AGA, 2MB chip)
echo HD:     %HD%
echo Kick:   %KICK%
echo WinUAE: %WINUAE%
echo.
echo The startup-sequence launches sunnyland.exe.
if /I "%~1"=="file" echo Log file: %HD%\sunnyland.log
echo.
start "" "%WINUAE%" -f "%UAE%"
endlocal
