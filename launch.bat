@echo off
setlocal EnableExtensions
set "ROOT=%~dp0"
set "ROOT=%ROOT:~0,-1%"

rem Launch the built SunnyLand binary in WinUAE as an OCS Amiga 500
rem with 512 KB chip + 512 KB slow (bogo) RAM, matching the target spec.

set "HD=%ROOT%\build"
if not exist "%HD%\sunnyland.exe" if not exist "%HD%\sunnyland" (
  echo Missing sunnyland binary. Run build.bat first.
  exit /b 1
)

set "WINUAE="
if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles(x86)%\Cloanto\Amiga Forever\WinUAE\WinUAE.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE64.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE64.exe"
) else if exist "%ProgramFiles%\WinUAE\WinUAE.exe" (
  set "WINUAE=%ProgramFiles%\WinUAE\WinUAE.exe"
)
if not defined WINUAE (
  echo WinUAE not found. Install Amiga Forever or WinUAE.
  exit /b 1
)

rem Kickstart 1.3 (Amiga 500) — supply your own legally obtained ROM.
set "KICK=%Public%\Documents\Amiga Files\Shared\rom\amiga-os-130.rom"
if not exist "%KICK%" set "KICK=%Public%\Documents\Amiga Files\Shared\rom\Kickstart v1.3 rev 34.5 (1987)(Commodore)(A500-A1000-A2000-CDTV).rom"
if not exist "%KICK%" set "KICK=%Public%\Documents\Amiga Files\WinUAE\rom\amiga-os-130.rom"
if not exist "%KICK%" set "KICK=%Public%\Documents\Amiga Files\WinUAE\rom\Kickstart v1.3 rev 34.5 (1987)(Commodore)(A500-A1000-A2000-CDTV).rom"
if not exist "%KICK%" (
  echo Kickstart 1.3 ROM not found under Amiga Files\...\rom
  exit /b 1
)

set "UAE=%ROOT%\sunnyland_a500.uae"
(
  echo ; Auto-generated by launch.bat — OCW Amiga 500 + SunnyLand HD
  echo use_gui=no
  echo quickstart=A500,0
  echo kickstart_rom_file=%KICK%
  echo chipset=ocs
  echo cpu_type=68000
  echo cpu_model=68000
  echo chipmem_size=1
  echo bogomem_size=1
  echo fastmem_size=0
  echo floppy0=
  echo floppy1=
  echo filesystem2=rw,DH0:SunnyLand:%HD%,0
  echo uaehf0=dir,rw,DH0:SunnyLand:%HD%,0
  echo boot_rom_uae=auto
  echo input.config=0
  echo joyport0=mouse
  echo joyport1=joy1
) > "%UAE%"

echo HD:     %HD%
echo Kick:   %KICK%
echo WinUAE: %WINUAE%
echo.
echo The generated startup-sequence will launch sunnyland automatically.
echo.
start "" "%WINUAE%" -f "%UAE%"
endlocal
